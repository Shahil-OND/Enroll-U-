# API Gateway REST URL
VITE_API_URL=https://YOUR_API_ID.execute-api.us-west-2.amazonaws.com/prod

# AWS Cognito Configuration
VITE_COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-west-2
# Cognito Hosted UI Domain (for Managed Login / PKCE redirect flow)
VITE_COGNITO_DOMAIN=enrollu-auth-xxxx.auth.us-west-2.amazoncognito.com
